# Your indexer application ID and hash from https://my.telegram.org/apps
API_ID=
API_HASH=
# Channel ID to index posts from, e.g. -1001234567890
CHANNEL_ID=
# Embedder params
EMBEDDER_URL=http://embedder:8000
# Qdrant params
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=posts
# Retry transient Qdrant disconnects
QDRANT_RETRY_ATTEMPTS=5
QDRANT_RETRY_BACKOFF_SECONDS=0.5
POSTGRES_DSN=
# How many months of history to index on first run
# >0 = last N months, 0 = skip, -1 = entire history
INITIAL_INDEX_MONTHS=0
